# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=etegram-api
PORT=3000
ENV=development
ENCRYPTION_KEY=replace-with-a-32-byte-random-string

# --- Database (MongoDB) ---
DB_URL=mongodb://localhost:27017/etegram

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRATION_TIME=3600s
JWT_REFRESH_EXPIRATION_TIME=7d

# --- SMTP / Mail ---
SMTP=smtp.example.com
HOST=smtp.example.com
EMAIL=user@example.com
PASSWORD=replace-with-smtp-password
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Etegram

# --- Brevo (transactional email API) ---
BREVO_API_KEY=replace-with-brevo-api-key

# --- Twilio (SMS/OTP) ---
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000

# --- AWS (S3-compatible storage) ---
AWS_ACCOUNT_ID=replace-with-aws-account-id
AWS_REGION=us-east-1
AWS_ACCESS_KEY=replace-with-aws-access-key
AWS_SECRET=replace-with-aws-secret-key
AWS_BUCKET_NAME=replace-with-bucket-name
AWS_BUCKET_URL=https://replace-with-bucket-url

# --- ImageKit (product images) ---
IMAGEKIT_PUBLIC_KEY=replace-with-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=replace-with-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace-with-id

# --- Firebase Admin (push notifications) ---
# Path to a Firebase service-account JSON file (never commit this file).
FIREBASE_SERVICE_ACCOUNT=./firebase-adminsdk.json

# --- Invoices ---
INVOICE_BASE_URL=http://localhost:3000/invoices

# --- Docs auth (used by some env-var checks) ---
DOCS_PASSWORD=replace-with-a-docs-password
