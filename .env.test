# Dummy values so unit tests can boot without a real environment.
# Loaded automatically by the jest setupFiles hook — do not put real secrets here.
NODE_ENV=test
APP_NAME=etegram-api-test
PORT=3000
ENV=test
ENCRYPTION_KEY=test-encryption-key-000000000000
DB_URL=mongodb://localhost:27017/etegram_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=test-jwt-secret
JWT_REFRESH_SECRET=test-jwt-refresh-secret
DOCS_PASSWORD=test-docs-password
SMTP=smtp.example.com
HOST=smtp.example.com
EMAIL=test@example.com
PASSWORD=test-password
IMAGEKIT_PUBLIC_KEY=test_public_key
IMAGEKIT_PRIVATE_KEY=test_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/test
BREVO_API_KEY=test_brevo_api_key
